<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vendas — Impacto Pasivo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<style>
  :root{
    --bg:#0b0d12;
    --panel:#12151c;
    --panel-2:#171b24;
    --border:#232834;
    --text:#e8eaef;
    --muted:#8a8f9c;
    --accent:#5b8cff;
    --accent-2:#3ddc97;
    --accent-3:#ffb84d;
    --accent-4:#ff6b81;
    --accent-5:#c792ea;
    --accent-6:#4dd0e1;
    --dl-light:#e8eaef;
    --dl-dark:#0b0d12;
  }
  html.light{
    --bg:#f4f5f8;
    --panel:#ffffff;
    --panel-2:#eef0f4;
    --border:#dde1e8;
    --text:#1b1e27;
    --muted:#6b7180;
    --dl-light:#1b1e27;
    --dl-dark:#0b0d12;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Space Grotesk',sans-serif;
    padding:132px 24px 80px;
    transition:background .2s ease, color .2s ease;
  }
  .wrap{max-width:1180px;margin:0 auto;}
  header{margin-bottom:36px;}
  .eyebrow{
    color:var(--accent);
    font-size:13px;
    letter-spacing:.12em;
    text-transform:uppercase;
    font-weight:600;
    margin-bottom:8px;
  }
  h1{font-size:32px;margin:0 0 6px;font-weight:700;}
  .subtitle{color:var(--muted);font-size:14px;}

  .toolbar{
    position:fixed;
    top:0;left:0;right:0;
    z-index:100;
    background:var(--panel);
    border-bottom:1px solid var(--border);
    padding:12px 24px;
    display:flex;
    justify-content:flex-end;
    gap:10px;
    flex-wrap:wrap;
  }
  .toggle-group{
    display:flex;
    background:var(--panel-2);
    border:1px solid var(--border);
    border-radius:10px;
    padding:3px;
    gap:2px;
  }
  .toggle-group button{
    border:none;
    background:transparent;
    color:var(--muted);
    font-family:'Space Grotesk',sans-serif;
    font-size:12px;
    font-weight:600;
    padding:7px 14px;
    border-radius:7px;
    cursor:pointer;
    transition:background .15s ease, color .15s ease;
  }
  .toggle-group button.active{
    background:var(--accent);
    color:#fff;
  }
  .tabs-bar{
    position:fixed;
    top:49px;left:0;right:0;
    z-index:99;
    background:var(--bg);
    border-bottom:1px solid var(--border);
    padding:0 24px;
    display:flex;
    gap:4px;
    overflow-x:auto;
  }
  .tab-btn{
    border:none;
    background:transparent;
    color:var(--muted);
    font-family:'Space Grotesk',sans-serif;
    font-size:13px;
    font-weight:600;
    padding:14px 16px 12px;
    cursor:pointer;
    border-bottom:2px solid transparent;
    white-space:nowrap;
  }
  .tab-btn.active{
    color:var(--text);
    border-bottom-color:var(--accent);
  }
  .tab-panel{display:none;}
  .tab-panel.active{display:block;}
  .region-cols{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  .region-label{
    display:inline-block;
    font-family:'DM Mono',monospace;
    font-size:12px;
    font-weight:600;
    padding:4px 12px;
    border-radius:20px;
    margin-bottom:14px;
  }
  .region-label.esp{background:rgba(255,184,77,0.15);color:#ffb84d;border:1px solid rgba(255,184,77,0.35);}
  .region-label.latam{background:rgba(91,140,255,0.15);color:#5b8cff;border:1px solid rgba(91,140,255,0.35);}
  @media(max-width:900px){
    .region-cols{grid-template-columns:1fr;}
  }

  .kpis{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
    margin:28px 0 40px;
  }
  .kpi{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    padding:18px 20px;
  }
  .kpi .label{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;}
  .kpi .value{font-family:'DM Mono',monospace;font-size:24px;font-weight:500;}
  .kpi .value.accent{color:var(--accent-2);}

  section{margin-bottom:48px;}
  .section-title{
    display:flex;
    align-items:baseline;
    gap:10px;
    margin-bottom:18px;
    padding-bottom:12px;
    border-bottom:1px solid var(--border);
  }
  .section-title h2{font-size:18px;margin:0;font-weight:600;}
  .section-title .tag{
    font-family:'DM Mono',monospace;
    font-size:11px;
    color:var(--accent);
    background:rgba(91,140,255,0.1);
    padding:3px 9px;
    border-radius:20px;
    border:1px solid rgba(91,140,255,0.3);
  }

  .grid-2{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;}
  .panel{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:16px;
    padding:22px;
  }
  .panel h3{margin:0 0 16px;font-size:14px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em;}
  .chart-box{position:relative;height:340px;}
  .chart-box.tall{height:420px;}

  table{width:100%;border-collapse:collapse;font-family:'DM Mono',monospace;font-size:13px;}
  th{
    text-align:left;
    color:var(--muted);
    font-weight:500;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.05em;
    padding:8px 10px;
    border-bottom:1px solid var(--border);
  }
  td{padding:9px 10px;border-bottom:1px solid rgba(128,128,128,0.12);color:var(--text);}
  tr:last-child td{border-bottom:none;}
  td.num{text-align:right;}

  .divider{
    margin:56px 0 40px;
    text-align:center;
    position:relative;
    color:var(--muted);
    font-size:12px;
    letter-spacing:.1em;
    text-transform:uppercase;
  }
  .divider::before{
    content:'';
    position:absolute;left:0;right:0;top:50%;
    height:1px;background:var(--border);
  }
  .divider span{background:var(--bg);padding:0 16px;position:relative;}

  .jan-banner{
    background:linear-gradient(135deg, rgba(91,140,255,0.12), rgba(61,220,151,0.08));
    border:1px solid rgba(91,140,255,0.25);
    border-radius:16px;
    padding:24px 28px;
    margin-bottom:28px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:16px;
  }
  .jan-banner .title{font-size:20px;font-weight:700;}
  .jan-banner .desc{color:var(--muted);font-size:13px;margin-top:4px;}
  .jan-banner .big{font-family:'DM Mono',monospace;font-size:28px;color:var(--accent-2);font-weight:500;}

  footer{
    margin-top:60px;
    text-align:center;
    color:var(--muted);
    font-size:12px;
  }

  .creatives-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(220px, 1fr));
    gap:16px;
  }
  .creative-card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    overflow:hidden;
    position:relative;
  }
  .creative-thumb{
    width:100%;
    aspect-ratio:1/1;
    object-fit:cover;
    background:var(--panel-2);
    display:block;
  }
  .creative-badge{
    position:absolute;
    top:10px;left:10px;
    font-size:10px;
    font-weight:700;
    letter-spacing:.04em;
    text-transform:uppercase;
    padding:4px 9px;
    border-radius:20px;
    color:#0b0d12;
  }
  .badge-volume{background:#3ddc97;}
  .badge-cpl{background:#5b8cff;color:#fff;}
  .creative-body{padding:14px 16px 16px;}
  .creative-name{font-family:'DM Mono',monospace;font-size:13px;font-weight:500;margin-bottom:10px;word-break:break-word;}
  .creative-stats{display:flex;flex-direction:column;gap:5px;font-size:12px;}
  .creative-stats .row{display:flex;justify-content:space-between;color:var(--muted);}
  .creative-stats .row b{color:var(--text);font-family:'DM Mono',monospace;}

  @media(max-width:900px){
    .kpis{grid-template-columns:repeat(2,1fr);}
    .grid-2{grid-template-columns:1fr;}
    .toolbar{justify-content:center;}
  }
</style>
</head>
<body>

<div class="toolbar">
  <div class="toggle-group" id="langToggle">
    <button data-lang="pt" class="active">Português</button>
    <button data-lang="es">Español</button>
  </div>
  <div class="toggle-group" id="themeToggle">
    <button data-theme="dark" class="active">Escuro</button>
    <button data-theme="light">Claro</button>
  </div>
</div>

<div class="tabs-bar" id="tabsBar">
  <button class="tab-btn active" data-tab="tabVendas" data-i18n="tabVendas">Vendas & Investimento</button>
  <button class="tab-btn" data-tab="tabAds" data-i18n="tabAds">Melhores Públicos e Anúncios</button>
  <button class="tab-btn" data-tab="tabPesquisa" data-i18n="tabPesquisa">Pesquisa do Evento</button>
</div>

<div id="tabVendas" class="tab-panel active">
<div class="wrap">

  <header>
    <div class="eyebrow" data-i18n="eyebrow">Relatório de Vendas</div>
    <h1 data-i18n="h1">Impacto Pasivo — Visão Geral</h1>
    <div class="subtitle" data-i18n="subtitle">Período: jul/2025 a jun/2026 · Valores em Facturación Bruta · 212 transações</div>
  </header>

  <div class="kpis">
    <div class="kpi">
      <div class="label" data-i18n="kpiTotalLabel">Faturamento Total</div>
      <div class="value accent" id="kpiTotal">—</div>
    </div>
    <div class="kpi">
      <div class="label" data-i18n="kpiCountLabel">Total de Vendas</div>
      <div class="value" id="kpiCount">—</div>
    </div>
    <div class="kpi">
      <div class="label" data-i18n="kpiAvgLabel">Ticket Médio</div>
      <div class="value" id="kpiAvg">—</div>
    </div>
    <div class="kpi">
      <div class="label" data-i18n="kpiCountriesLabel">Países Atendidos</div>
      <div class="value" id="kpiCountries">—</div>
    </div>
  </div>

  <section>
    <div class="section-title">
      <h2 data-i18n="s1h2">Vendas por Mês</h2>
      <span class="tag" data-i18n="s1tag">por país</span>
    </div>
    <div class="panel">
      <div class="chart-box tall"><canvas id="monthChart"></canvas></div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="s2h2">Vendas por País</h2>
      <span class="tag" data-i18n="s2tag">total geral</span>
    </div>
    <div class="grid-2">
      <div class="panel">
        <h3 data-i18n="faturamentoPorPais">Faturamento por País</h3>
        <div class="chart-box"><canvas id="countryChart"></canvas></div>
      </div>
      <div class="panel">
        <h3 data-i18n="ranking">Ranking</h3>
        <table>
          <thead><tr><th data-i18n="thPais">País</th><th class="num" data-i18n="thVendas">Vendas</th><th class="num" data-i18n="thFaturamento">Faturamento</th><th class="num">%</th></tr></thead>
          <tbody id="countryTable"></tbody>
        </table>
      </div>
    </div>
  </section>

  <div class="divider"><span data-i18n="recorteEspecial">Recorte Especial</span></div>

  <div class="jan-banner">
    <div>
      <div class="title" data-i18n="janTitle">Janeiro de 2026</div>
      <div class="desc" id="janDesc">—</div>
    </div>
    <div class="big" id="janTotal">—</div>
  </div>

  <section>
    <div class="section-title">
      <h2 data-i18n="s3h2">Vendas por Dia — Janeiro/2026</h2>
    </div>
    <div class="panel">
      <div class="chart-box tall"><canvas id="janDayChart"></canvas></div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="s4h2">Vendas por País — Janeiro/2026</h2>
    </div>
    <div class="grid-2">
      <div class="panel">
        <h3 data-i18n="faturamentoPorPais">Faturamento por País</h3>
        <div class="chart-box"><canvas id="janCountryChart"></canvas></div>
      </div>
      <div class="panel">
        <h3 data-i18n="ranking">Ranking</h3>
        <table>
          <thead><tr><th data-i18n="thPais">País</th><th class="num" data-i18n="thVendas">Vendas</th><th class="num" data-i18n="thFaturamento">Faturamento</th><th class="num">%</th></tr></thead>
          <tbody id="janCountryTable"></tbody>
        </table>
      </div>
    </div>
  </section>

  <footer data-i18n="footer1">Relatório gerado a partir do histórico de vendas Hotmart · Impacto Pasivo</footer>
</div>

<div class="wrap" id="generalAdsWrap" style="display:none;">
  <div class="divider"><span data-i18n="dividerGeneral">Meta Ads — Investimento Geral</span></div>

  <div class="kpis" id="generalKpis"></div>

  <section>
    <div class="section-title">
      <h2 data-i18n="ginvDiario">Investimento Diário</h2>
      <span class="tag" data-i18n="jan2026tag">Janeiro/2026</span>
    </div>
    <div class="panel">
      <div class="chart-box tall"><canvas id="generalSpendChart"></canvas></div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="cplDiario">CPL Diário</h2>
      <span class="tag" data-i18n="jan2026tag">Janeiro/2026</span>
    </div>
    <div class="panel">
      <div class="chart-box tall"><canvas id="generalCplChart"></canvas></div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="invPorFrente">Investimento por Frente</h2>
      <span class="tag">ESP x LATAM</span>
    </div>
    <div class="grid-2">
      <div class="panel">
        <h3 data-i18n="distribInv">Distribuição do Investimento</h3>
        <div class="chart-box"><canvas id="investSplitChart"></canvas></div>
      </div>
      <div class="panel">
        <h3 data-i18n="roasPorFrente">ROAS por Frente</h3>
        <div class="chart-box"><canvas id="roasCompareChart"></canvas></div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="invRetGeral">Investimento x Retorno — Geral</h2>
      <span class="tag" data-i18n="jan2026tag">Janeiro/2026</span>
    </div>
    <div class="grid-2">
      <div class="panel">
        <h3 data-i18n="invVsFat">Investido vs Faturado</h3>
        <div class="chart-box"><canvas id="generalRoasChart"></canvas></div>
      </div>
      <div class="panel">
        <h3 data-i18n="resumo">Resumo</h3>
        <table>
          <thead><tr><th data-i18n="thMetrica">Métrica</th><th class="num" data-i18n="thValor">Valor</th></tr></thead>
          <tbody id="generalRoasTable"></tbody>
        </table>
      </div>
    </div>
  </section>

  <footer data-i18n="footer2">Investimento referente a todas as campanhas (ESP + LATAM) · Meta Ads · Janeiro/2026</footer>
</div>

<div class="wrap" id="latamWrap" style="display:none;">
  <div class="divider"><span>Meta Ads — LATAM</span></div>

  <section>
    <div class="section-title">
      <h2 data-i18n="estrategiaPublicos">Estratégia de Públicos — LATAM (Janeiro/2026)</h2>
    </div>
    <div class="grid-2">
      <div class="panel">
        <h3 data-i18n="publicoFrio">Público Frio</h3>
        <div style="font-size:14px;color:var(--text);line-height:1.6;" data-i18n="publicoFrioDesc">
          Localização — Inclusão: <strong>Argentina, Colômbia</strong>
        </div>
      </div>
      <div class="panel">
        <h3 data-i18n="publicoQuente">Público Quente</h3>
        <div style="font-size:14px;color:var(--text);line-height:1.6;" data-i18n="publicoQuenteDesc">
          Toda a <strong>América do Sul</strong>, exceto Venezuela
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="invDiarioLatam">Investimento Diário — LATAM</h2>
      <span class="tag" data-i18n="frioQuenteTag">Frio x Quente</span>
    </div>
    <div class="panel">
      <div class="chart-box tall"><canvas id="latamSpendChart"></canvas></div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="cplDiarioLatam">CPL Diário — LATAM</h2>
      <span class="tag" data-i18n="frioQuenteTag">Frio x Quente</span>
    </div>
    <div class="panel">
      <div class="chart-box tall"><canvas id="latamCplChart"></canvas></div>
    </div>
  </section>

  <div class="kpis" id="latamKpis"></div>

  <section>
    <div class="section-title">
      <h2 data-i18n="invRetLatam">Investimento x Retorno — LATAM</h2>
      <span class="tag" data-i18n="jan2026tag">Janeiro/2026</span>
    </div>
    <div class="grid-2">
      <div class="panel">
        <h3 data-i18n="invVsFat">Investido vs Faturado</h3>
        <div class="chart-box"><canvas id="latamRoasChart"></canvas></div>
      </div>
      <div class="panel">
        <h3 data-i18n="resumo">Resumo</h3>
        <table>
          <thead><tr><th data-i18n="thMetrica">Métrica</th><th class="num" data-i18n="thValor">Valor</th></tr></thead>
          <tbody id="latamRoasTable"></tbody>
        </table>
      </div>
    </div>
  </section>

  <footer data-i18n="footer3">Investimento referente apenas às campanhas LATAM (Frio + Quente) · Meta Ads · Janeiro/2026</footer>
</div>
</div>

<div id="tabAds" class="tab-panel">
<div class="wrap" id="creativesWrap" style="display:none;">
  <div class="divider"><span data-i18n="dividerCreatives">Melhores Públicos e Anúncios</span></div>

  <section>
    <div class="section-title">
      <h2 data-i18n="audiencesTitle">Ranking de Públicos</h2>
      <span class="tag" data-i18n="creativesTag">Volume x CPL</span>
    </div>
    <div class="region-cols">
      <div>
        <span class="region-label esp">España</span>
        <div class="panel">
          <div class="chart-box tall"><canvas id="audienceChart-ESP"></canvas></div>
        </div>
      </div>
      <div>
        <span class="region-label latam">LATAM</span>
        <div class="panel">
          <div class="chart-box tall"><canvas id="audienceChart-LATAM"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="creativesTitle">Ranking de Criativos</h2>
      <span class="tag" data-i18n="creativesTag">Volume x CPL</span>
    </div>
    <div class="region-cols">
      <div>
        <span class="region-label esp">España</span>
        <div id="creativesGrid-ESP" class="creatives-grid"></div>
      </div>
      <div>
        <span class="region-label latam">LATAM</span>
        <div id="creativesGrid-LATAM" class="creatives-grid"></div>
      </div>
    </div>
  </section>
</div>
</div>

<div id="tabPesquisa" class="tab-panel">
<div class="wrap" id="pesquisaWrap" style="display:none;">
  <header>
    <div class="eyebrow" data-i18n="pesquisaEyebrow">Pesquisa do Evento</div>
    <h1 data-i18n="pesquisaH1">Evento de Janeiro/2026 — Perfil dos Inscritos</h1>
    <div class="subtitle" id="pesquisaSubtitle">—</div>
  </header>

  <div class="kpis" id="pesquisaKpis"></div>

  <section>
    <div class="section-title">
      <h2 data-i18n="paisPesquisa">País dos Respondentes</h2>
    </div>
    <div class="panel">
      <div class="chart-box"><canvas id="pesquisaPaisChart"></canvas></div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="faixaEtaria">Faixa Etária</h2>
    </div>
    <div class="panel">
      <div class="chart-box"><canvas id="pesquisaEdadChart"></canvas></div>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2 data-i18n="rendaMensal">Renda Mensal</h2>
    </div>
    <div class="panel">
      <div class="chart-box tall"><canvas id="pesquisaIngresosChart"></canvas></div>
    </div>
  </section>

  <div class="grid-2">
    <section>
      <div class="section-title">
        <h2 data-i18n="tempoCripto">Tempo no Mundo Cripto</h2>
      </div>
      <div class="panel">
        <div class="chart-box"><canvas id="pesquisaTempoChart"></canvas></div>
      </div>
    </section>
    <section>
      <div class="section-title">
        <h2 data-i18n="comoConheceu">Como Conheceu o Evento</h2>
      </div>
      <div class="panel">
        <div class="chart-box"><canvas id="pesquisaComoChart"></canvas></div>
      </div>
    </section>
  </div>

  <div class="grid-2">
    <section>
      <div class="section-title">
        <h2 data-i18n="ocupacao">Ocupação</h2>
