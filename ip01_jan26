let currentLang = 'pt';
let currentTheme = 'dark';
let chartInstances = [];

function track(chart){ chartInstances.push(chart); return chart; }
function destroyAll(){ chartInstances.forEach(c=>{ try{ c.destroy(); }catch(e){} }); chartInstances = []; }

function applyStaticText(lang){
  const dict = I18N[lang];
  document.documentElement.lang = lang==='es' ? 'es-ES' : 'pt-BR';
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const key = el.getAttribute('data-i18n');
    if (dict[key] !== undefined) el.innerHTML = dict[key];
  });
}

function getChartTextColor(theme){
  return theme==='light' ? '#1b1e27' : '#8a8f9c';
}
function getDlOnColorBg(theme){
  // for datalabels placed on colored bar fills (light bg always works ok with dark text)
  return '#0b0d12';
}
function getDlFreeText(theme){
  // for datalabels placed over transparent panel background (line charts etc)
  return theme==='light' ? '#1b1e27' : '#e8eaef';
}
function getPanelHexForBorder(theme){
  return theme==='light' ? '#ffffff' : '#12151c';
}

function buildAll(lang, theme){
  destroyAll();
  const dict = I18N[lang];
  applyStaticText(lang);

  Chart.defaults.color = getChartTextColor(theme);
  Chart.defaults.font.family = "'Space Grotesk', sans-serif";
  Chart.defaults.borderColor = theme==='light' ? '#dde1e8' : '#232834';

  const dlFree = getDlFreeText(theme);
  const panelBorder = getPanelHexForBorder(theme);

  // ===== KPIs (main) =====
  document.getElementById('kpiTotal').textContent = fmtEUR(DATA.total_all, lang);
  document.getElementById('kpiCount').textContent = fmtNum(DATA.count_all, lang);
  document.getElementById('kpiAvg').textContent = fmtEUR(DATA.total_all/DATA.count_all, lang);
  document.getElementById('kpiCountries').textContent = DATA.overall.country_order.length;

  // Month chart - stacked bar by country
  const monthLabels = DATA.overall.months.map(m=>{
    const [y,mo]=m.split('-');
    const namesPt=['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
    const namesEs=['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
    const names = lang==='es' ? namesEs : namesPt;
    return names[parseInt(mo)-1]+'/'+y.slice(2);
  });
  const monthDatasets = DATA.overall.country_order.map((c,i)=>({
    label:c,
    data:DATA.overall.pivot[c],
    backgroundColor:palette[i%palette.length],
    borderRadius:4,
    stack:'s'
  }));

  track(new Chart(document.getElementById('monthChart'),{
    type:'bar',
    data:{labels:monthLabels, datasets:monthDatasets},
    options:{
      responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{position:'bottom', labels:{boxWidth:10,padding:14,font:{size:11}}},
        tooltip:{callbacks:{label:(ctx)=>` ${ctx.dataset.label}: ${fmtEUR(ctx.raw, lang)}`}}
      },
      scales:{
        x:{stacked:true, grid:{display:false}},
        y:{stacked:true, beginAtZero:true, ticks:{callback:(v)=>fmtEUR(v, lang)}}
      }
    }
  }));

  // Country chart (overall)
  const countryLabels = DATA.overall.country_order;
  const countryValues = countryLabels.map(c=>DATA.overall.country_totals[c]);
  track(new Chart(document.getElementById('countryChart'),{
    type:'doughnut',
    data:{
      labels:countryLabels,
      datasets:[{data:countryValues, backgroundColor:palette, borderColor:panelBorder, borderWidth:2}]
