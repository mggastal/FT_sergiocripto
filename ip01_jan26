          datasets:[{label:dict.creativeLeads, data:leads, backgroundColor:color, borderRadius:6, maxBarThickness:26}]
        },
        plugins:[ChartDataLabels],
        options:{
          indexAxis:'y',
          responsive:true,maintainAspectRatio:false,
          plugins:{
            legend:{display:false},
            datalabels:{color:dlFree, font:{size:10,weight:'700',family:"'DM Mono', monospace"}, anchor:'end', align:'right',
              formatter:(v,ctx)=> `${fmtNum(v, lang)} (${fmtEUR(cpls[ctx.dataIndex], lang)})`},
            tooltip:{callbacks:{label:(ctx)=>` ${fmtNum(ctx.raw, lang)} leads · CPL ${fmtEUR(cpls[ctx.dataIndex], lang)}`}}
          },
          scales:{
            x:{beginAtZero:true, grace:'35%', ticks:{display:false}, grid:{display:false}},
            y:{grid:{display:false}, ticks:{font:{size:10}}}
          }
        }
      }));
    });

    ['ESP','LATAM'].forEach(region=>{
      const list = CREATIVES_REGION[region] || [];
      const grid = document.getElementById('creativesGrid-'+region);
      grid.innerHTML = '';
      if (!list.length) return;
      const bestVolumeName = list.slice().sort((a,b)=>b.leads-a.leads)[0].name;
      const bestCplName = list.slice().sort((a,b)=>a.cpl-b.cpl)[0].name;
      list.slice().sort((a,b)=>b.leads-a.leads).forEach(c=>{
        const card = document.createElement('div');
        card.className = 'creative-card';
        let badge = '';
        if (c.name === bestVolumeName) badge = `<span class="creative-badge badge-volume">${dict.badgeVolume}</span>`;
        else if (c.name === bestCplName) badge = `<span class="creative-badge badge-cpl">${dict.badgeCpl}</span>`;
        card.innerHTML = `
          ${badge}
          <img class="creative-thumb" src="${c.thumb}" alt="${c.name}" onerror="this.style.display='none'">
          <div class="creative-body">
            <div class="creative-name">${c.name}</div>
            <div class="creative-stats">
              <div class="row"><span>${dict.creativeLeads}</span><b>${fmtNum(c.leads, lang)}</b></div>
              <div class="row"><span>${dict.creativeCpl}</span><b>${fmtEUR(c.cpl, lang)}</b></div>
              <div class="row"><span>${dict.creativeSpend}</span><b>${fmtEUR(c.spend, lang)}</b></div>
              <div class="row"><span>${dict.creativeImpr}</span><b>${fmtNum(c.impressions, lang)}</b></div>
            </div>
          </div>
        `;
        grid.appendChild(card);
      });
    });
  }

  // ===== LATAM Meta Ads section =====
  if (typeof LATAM !== 'undefined') {
    document.getElementById('latamWrap').style.display = 'block';

    const latamDayLabels = LATAM.dates.map(d=>{
      const p = d.split('-');
      return p[2]+'/'+p[1];
    });

    track(new Chart(document.getElementById('latamSpendChart'),{
      type:'bar',
      data:{
        labels:latamDayLabels,
        datasets:[
          {label:dict.legFrio, data:LATAM.frio_spend, backgroundColor:'#5b8cff', borderRadius:4, stack:'s'},
          {label:dict.legQuente, data:LATAM.quente_spend, backgroundColor:'#ff6b81', borderRadius:4, stack:'s'}
        ]
      },
      plugins:[ChartDataLabels],
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:10,padding:14,font:{size:11}}},
          datalabels:{color:'#0b0d12', font:{size:9,weight:'700'}, formatter:(v)=> v<5 ? '' : fmtEUR(v, lang)},
          tooltip:{callbacks:{label:(ctx)=>` ${ctx.dataset.label}: ${fmtEUR(ctx.raw, lang)}`}}
        },
        scales:{
          x:{stacked:true, grid:{display:false}},
          y:{stacked:true, beginAtZero:true, ticks:{callback:(v)=>fmtEUR(v, lang)}}
        }
      }
    }));

    const frioCpl = LATAM.frio_spend.map((s,i)=> LATAM.frio_leads[i] ? +(s/LATAM.frio_leads[i]).toFixed(2) : null);
    const quenteCpl = LATAM.quente_spend.map((s,i)=> LATAM.quente_leads[i] ? +(s/LATAM.quente_leads[i]).toFixed(2) : null);

    track(new Chart(document.getElementById('latamCplChart'),{
      type:'line',
      data:{
        labels:latamDayLabels,
        datasets:[
          {label:dict.legCplFrio, data:frioCpl, borderColor:'#5b8cff', backgroundColor:'#5b8cff', tension:.35, pointRadius:3, spanGaps:true},
          {label:dict.legCplQuente, data:quenteCpl, borderColor:'#ff6b81', backgroundColor:'#ff6b81', tension:.35, pointRadius:3, spanGaps:true}
        ]
      },
      plugins:[ChartDataLabels],
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:10,padding:14,font:{size:11}}},
          datalabels:{color:dlFree, font:{size:9,weight:'600',family:"'DM Mono', monospace"}, align:'top', formatter:(v)=> v==null?'':fmtEUR(v, lang)},
          tooltip:{callbacks:{label:(ctx)=>` ${ctx.dataset.label}: ${fmtEUR(ctx.raw, lang)}`}}
        },
        scales:{
          x:{grid:{display:false}},
          y:{beginAtZero:true, ticks:{callback:(v)=>fmtEUR(v, lang)}, grace:'15%'}
        }
      }
    }));

    // KPI cards
    const latamKpis = document.getElementById('latamKpis');
    const cplGeral = LATAM.total_spend/LATAM.total_leads;
    const cplFrio = LATAM.frio_total_spend/LATAM.frio_total_leads;
    const cplQuente = LATAM.quente_total_spend/LATAM.quente_total_leads;
    latamKpis.innerHTML = `
      <div class="kpi"><div class="label">${dict.kpiInvTotalLatam}</div><div class="value accent">${fmtEUR(LATAM.total_spend, lang)}</div></div>
      <div class="kpi"><div class="label">${dict.kpiLeadsTotais}</div><div class="value">${fmtNum(LATAM.total_leads, lang)}</div></div>
      <div class="kpi"><div class="label">${dict.kpiCplGeral}</div><div class="value">${fmtEUR(cplGeral, lang)}</div></div>
      <div class="kpi"><div class="label">${dict.kpiCplFrioQuente}</div><div class="value" style="font-size:18px;">${fmtEUR(cplFrio, lang)} / ${fmtEUR(cplQuente, lang)}</div></div>
    `;

    // Investment vs Return chart
    track(new Chart(document.getElementById('latamRoasChart'),{
      type:'bar',
      data:{
        labels:[dict.latamJan],
        datasets:[
          {label:dict.legInvestido, data:[LATAM.total_spend], backgroundColor:'#5b8cff', borderRadius:6, maxBarThickness:70},
          {label:dict.legFaturado, data:[LATAM.sales_return], backgroundColor:'#3ddc97', borderRadius:6, maxBarThickness:70}
        ]
      },
      plugins:[ChartDataLabels],
      options:{
        indexAxis:'y',
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:10,padding:14,font:{size:11}}},
          datalabels:{color:'#0b0d12', font:{size:11,weight:'700'}, formatter:(v)=>fmtEUR(v, lang)},
          tooltip:{callbacks:{label:(ctx)=>` ${ctx.dataset.label}: ${fmtEUR(ctx.raw, lang)}`}}
        },
        scales:{
          x:{beginAtZero:true, ticks:{callback:(v)=>fmtEUR(v, lang)}},
          y:{grid:{display:false}}
        }
      }
    }));

    const roas = LATAM.sales_return/LATAM.total_spend;
    const lucro = LATAM.sales_return - LATAM.total_spend;
    const roasBody = document.getElementById('latamRoasTable');
    roasBody.innerHTML = `
      <tr><td>${dict.rowInvestidoLatam}</td><td class="num">${fmtEUR(LATAM.total_spend, lang)}</td></tr>
      <tr><td>${dict.rowFaturadoLatamPaises}</td><td class="num">${fmtEUR(LATAM.sales_return, lang)}</td></tr>
      <tr><td>${dict.rowRoas}</td><td class="num">${roas.toFixed(2)}x</td></tr>
      <tr><td>${dict.rowLucroBruto}</td><td class="num">${fmtEUR(lucro, lang)}</td></tr>
      <tr><td>${dict.rowCplGeral}</td><td class="num">${fmtEUR(cplGeral, lang)}</td></tr>
    `;
  }

  // ===== Pesquisa do Evento =====
  if (typeof SURVEY !== 'undefined') {
    document.getElementById('pesquisaWrap').style.display = 'block';

    document.getElementById('pesquisaSubtitle').textContent = `${SURVEY.total} ${dict.janVendas==='vendas'?'respostas':'respuestas'}`;

    const pctEspanha = (SURVEY.country_values[SURVEY.country_labels.indexOf('España')]/SURVEY.total*100).toFixed(0);
    const pctFilhos = (SURVEY.hijos_values[SURVEY.hijos_labels.indexOf('Sí')]/SURVEY.total*100).toFixed(0);
    const idxMais2 = SURVEY.tempo_labels.indexOf('Más de 2 años');
    const pctExperientes = (SURVEY.tempo_values[idxMais2]/SURVEY.total*100).toFixed(0);
    const pesquisaKpis = document.getElementById('pesquisaKpis');
    pesquisaKpis.innerHTML = `
      <div class="kpi"><div class="label">${dict.kpiTotalRespostas}</div><div class="value accent">${fmtNum(SURVEY.total, lang)}</div></div>
      <div class="kpi"><div class="label">${dict.kpiPctEspanha}</div><div class="value">${pctEspanha}%</div></div>
      <div class="kpi"><div class="label">${dict.kpiPctComFilhos}</div><div class="value">${pctFilhos}%</div></div>
      <div class="kpi"><div class="label">${dict.kpiPctExperientes}</div><div class="value">${pctExperientes}%</div></div>
    `;

    track(new Chart(document.getElementById('pesquisaPaisChart'),{
      type:'doughnut',
      data:{
        labels:SURVEY.country_labels,
        datasets:[{data:SURVEY.country_values, backgroundColor:palette, borderColor:panelBorder, borderWidth:2}]
      },
      plugins:[ChartDataLabels],
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:10,padding:10,font:{size:11}}},
          datalabels:{color:'#0b0d12', font:{size:10,weight:'700'}, formatter:(v)=> v<8?'':`${v} (${(v/SURVEY.total*100).toFixed(0)}%)`},
          tooltip:{callbacks:{label:(ctx)=>` ${ctx.label}: ${fmtNum(ctx.raw, lang)} (${(ctx.raw/SURVEY.total*100).toFixed(0)}%)`}}
        },
        cutout:'55%'
      }
    }));

    track(new Chart(document.getElementById('pesquisaEdadChart'),{
      type:'bar',
      data:{
        labels:SURVEY.edad_labels,
        datasets:[{label:dict.faixaEtaria, data:SURVEY.edad_values, backgroundColor:'#3ddc97', borderRadius:6, maxBarThickness:48}]
      },
      plugins:[ChartDataLabels],
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{display:false},
          datalabels:{color:dlFree, font:{size:10,weight:'700'}, anchor:'end', align:'top', formatter:(v)=>v===0?'':`${v} (${(v/SURVEY.total*100).toFixed(0)}%)`},
          tooltip:{callbacks:{label:(ctx)=>` ${fmtNum(ctx.raw, lang)} (${(ctx.raw/SURVEY.total*100).toFixed(0)}%)`}}
        },
        scales:{
          x:{grid:{display:false}, ticks:{font:{size:9}}},
          y:{beginAtZero:true, grace:'15%'}
        }
      }
    }));

    track(new Chart(document.getElementById('pesquisaIngresosChart'),{
      type:'bar',
      data:{
        labels:SURVEY.ingresos_labels,
        datasets:[{label:dict.rendaMensal, data:SURVEY.ingresos_values, backgroundColor:'#ffb84d', borderRadius:6, maxBarThickness:40}]
      },
      plugins:[ChartDataLabels],
      options:{
        indexAxis:'y',
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{display:false},
          datalabels:{color:dlFree, font:{size:10,weight:'700'}, anchor:'end', align:'right', formatter:(v)=>v===0?'':`${v} (${(v/SURVEY.total*100).toFixed(0)}%)`},
          tooltip:{callbacks:{label:(ctx)=>` ${fmtNum(ctx.raw, lang)} (${(ctx.raw/SURVEY.total*100).toFixed(0)}%)`}}
        },
        scales:{
          x:{beginAtZero:true, grace:'15%', grid:{display:false}},
          y:{ticks:{font:{size:10}}}
        }
      }
    }));

    track(new Chart(document.getElementById('pesquisaTempoChart'),{
      type:'doughnut',
      data:{
        labels:SURVEY.tempo_labels,
        datasets:[{data:SURVEY.tempo_values, backgroundColor:palette, borderColor:panelBorder, borderWidth:2}]
      },
      plugins:[ChartDataLabels],
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:10,padding:8,font:{size:10}}},
          datalabels:{color:'#0b0d12', font:{size:10,weight:'700'}, formatter:(v)=> v<8?'':`${v} (${(v/SURVEY.total*100).toFixed(0)}%)`},
          tooltip:{callbacks:{label:(ctx)=>` ${ctx.label}: ${fmtNum(ctx.raw, lang)} (${(ctx.raw/SURVEY.total*100).toFixed(0)}%)`}}
        },
        cutout:'55%'
      }
    }));

    track(new Chart(document.getElementById('pesquisaComoChart'),{
      type:'bar',
      data:{
        labels:SURVEY.como_labels,
        datasets:[{label:dict.comoConheceu, data:SURVEY.como_values, backgroundColor:'#c792ea', borderRadius:6, maxBarThickness:28}]
      },
      plugins:[ChartDataLabels],
      options:{
        indexAxis:'y',
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{display:false},
          datalabels:{color:dlFree, font:{size:10,weight:'700'}, anchor:'end', align:'right', formatter:(v)=>v===0?'':`${v} (${(v/SURVEY.total*100).toFixed(0)}%)`},
          tooltip:{callbacks:{label:(ctx)=>` ${fmtNum(ctx.raw, lang)} (${(ctx.raw/SURVEY.total*100).toFixed(0)}%)`}}
        },
        scales:{
          x:{beginAtZero:true, grace:'15%', grid:{display:false}},
          y:{ticks:{font:{size:10}}}
        }
      }
    }));

    track(new Chart(document.getElementById('pesquisaOcupChart'),{
      type:'bar',
      data:{
        labels:SURVEY.occ_labels,
        datasets:[{label:dict.ocupacao, data:SURVEY.occ_values, backgroundColor:'#4dd0e1', borderRadius:6, maxBarThickness:24}]
      },
      plugins:[ChartDataLabels],
      options:{
        indexAxis:'y',
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{display:false},
          datalabels:{color:dlFree, font:{size:9,weight:'700'}, anchor:'end', align:'right', formatter:(v)=>v===0?'':`${v} (${(v/SURVEY.total*100).toFixed(0)}%)`},
          tooltip:{callbacks:{label:(ctx)=>` ${fmtNum(ctx.raw, lang)} (${(ctx.raw/SURVEY.total*100).toFixed(0)}%)`}}
        },
        scales:{
          x:{beginAtZero:true, grace:'15%', grid:{display:false}},
          y:{ticks:{font:{size:9}}}
        }
      }
    }));

    track(new Chart(document.getElementById('pesquisaFilhosChart'),{
      type:'doughnut',
      data:{
        labels:SURVEY.hijos_labels,
        datasets:[{data:SURVEY.hijos_values, backgroundColor:['#3ddc97','#ff6b81'], borderColor:panelBorder, borderWidth:2}]
      },
      plugins:[ChartDataLabels],
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:10,padding:10,font:{size:11}}},
          datalabels:{color:'#0b0d12', font:{size:12,weight:'700'}, formatter:(v)=> `${v} (${(v/SURVEY.total*100).toFixed(0)}%)`},
          tooltip:{callbacks:{label:(ctx)=>` ${ctx.label}: ${fmtNum(ctx.raw, lang)} (${(ctx.raw/SURVEY.total*100).toFixed(0)}%)`}}
        },
        cutout:'62%'
      }
    }));

    track(new Chart(document.getElementById('pesquisaSituacaoChart'),{
      type:'bar',
      data:{
        labels:SURVEY.sit_labels,
        datasets:[{label:dict.situacaoAtual, data:SURVEY.sit_values, backgroundColor:'#aed581', borderRadius:6, maxBarThickness:28}]
      },
      plugins:[ChartDataLabels],
      options:{
        indexAxis:'y',
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{display:false},
          datalabels:{color:dlFree, font:{size:10,weight:'700'}, anchor:'end', align:'right', formatter:(v)=>v===0?'':`${v} (${(v/SURVEY.total*100).toFixed(0)}%)`},
          tooltip:{callbacks:{label:(ctx)=>` ${fmtNum(ctx.raw, lang)} (${(ctx.raw/SURVEY.total*100).toFixed(0)}%)`}}
        },
        scales:{
          x:{beginAtZero:true, grace:'15%', grid:{display:false}},
          y:{ticks:{font:{size:10}}}
        }
      }
    }));
  }
}

// ===== Toolbar wiring =====
document.getElementById('langToggle').addEventListener('click', (e)=>{
  const btn = e.target.closest('button[data-lang]');
  if (!btn) return;
  currentLang = btn.getAttribute('data-lang');
  document.querySelectorAll('#langToggle button').forEach(b=>b.classList.toggle('active', b===btn));
  buildAll(currentLang, currentTheme);
});

document.getElementById('themeToggle').addEventListener('click', (e)=>{
  const btn = e.target.closest('button[data-theme]');
  if (!btn) return;
  currentTheme = btn.getAttribute('data-theme');
  document.querySelectorAll('#themeToggle button').forEach(b=>b.classList.toggle('active', b===btn));
  document.documentElement.classList.toggle('light', currentTheme==='light');
  buildAll(currentLang, currentTheme);
});

document.getElementById('tabsBar').addEventListener('click', (e)=>{
  const btn = e.target.closest('button[data-tab]');
  if (!btn) return;
  const tab = btn.getAttribute('data-tab');
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.toggle('active', b===btn));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.toggle('active', p.id===tab));
});

buildAll(currentLang, currentTheme);
</script>

</body>
</html>
